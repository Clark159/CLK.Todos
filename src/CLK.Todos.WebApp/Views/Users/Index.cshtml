@model IReadOnlyList<User>

@{
    ViewData["Title"] = "使用者清單";
}

<h1>使用者清單</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">+ 新增使用者</a>
</p>

@if (!Model.Any())
{
    <p>目前沒有使用者，點上面按鈕新增一筆吧。</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>姓名</th>
                <th>電子郵件</th>
                <th style="width: 1%; white-space: nowrap;">建立時間</th>
                <th style="width: 1%; white-space: nowrap;">更新時間</th>
                <th style="width: 1%; white-space: nowrap;">動作</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Name</td>
                    <td>@user.Email</td>
                    <td style="white-space: nowrap;">@user.CreateTime.ToString("yyyy-MM-dd HH:mm")</td>
                    <td style="white-space: nowrap;">@user.UpdateTime.ToString("yyyy-MM-dd HH:mm")</td>
                    <td style="white-space: nowrap;">
                        <a asp-action="Edit" asp-route-userId="@user.UserId" class="btn btn-sm btn-outline-primary">編輯</a>
                        <a asp-action="Delete" asp-route-userId="@user.UserId" class="btn btn-sm btn-outline-danger">刪除</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
