@model Meeting

@{
    ViewData["Title"] = "刪除會議";
}

<h1>刪除會議</h1>

<p>確定要刪除下面這筆會議嗎？</p>

<dl class="row">
    <dt class="col-sm-2">主題</dt>
    <dd class="col-sm-10">@Model.Title</dd>

    <dt class="col-sm-2">開始時間</dt>
    <dd class="col-sm-10">@Model.StartTime.ToString("yyyy-MM-dd HH:mm")</dd>

    <dt class="col-sm-2">結束時間</dt>
    <dd class="col-sm-10">@Model.EndTime.ToString("yyyy-MM-dd HH:mm")</dd>

    <dt class="col-sm-2">地點</dt>
    <dd class="col-sm-10">@Model.Location</dd>

    <dt class="col-sm-2">建立時間</dt>
    <dd class="col-sm-10">@Model.CreateTime.ToString("yyyy-MM-dd HH:mm")</dd>

    <dt class="col-sm-2">更新時間</dt>
    <dd class="col-sm-10">@Model.UpdateTime.ToString("yyyy-MM-dd HH:mm")</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="MeetingId" />
    <button type="submit" class="btn btn-danger">確定刪除</button>
    <a asp-action="Index" class="btn btn-secondary">取消</a>
</form>
