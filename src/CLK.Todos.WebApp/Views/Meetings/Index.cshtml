@model IReadOnlyList<Meeting>

@{
    ViewData["Title"] = "會議清單";
}

<h1>會議清單</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">+ 新增會議</a>
</p>

@if (!Model.Any())
{
    <p>目前沒有會議，點上面按鈕新增一筆吧。</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>主題</th>
                <th style="width: 1%; white-space: nowrap;">開始時間</th>
                <th style="width: 1%; white-space: nowrap;">結束時間</th>
                <th>地點</th>
                <th style="width: 1%; white-space: nowrap;">狀態</th>
                <th style="width: 1%; white-space: nowrap;">動作</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var meeting in Model)
            {
                <tr>
                    <td>@meeting.Title</td>
                    <td style="white-space: nowrap;">@meeting.StartTime.ToString("yyyy-MM-dd HH:mm")</td>
                    <td style="white-space: nowrap;">@meeting.EndTime.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@meeting.Location</td>
                    <td style="white-space: nowrap;">
                        <form asp-action="Toggle" asp-route-meetingId="@meeting.MeetingId" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm @(meeting.IsCancelled ? "btn-outline-secondary" : "btn-success")">
                                @(meeting.IsCancelled ? "已取消" : "進行中")
                            </button>
                        </form>
                    </td>
                    <td style="white-space: nowrap;">
                        <a asp-action="Edit" asp-route-meetingId="@meeting.MeetingId" class="btn btn-sm btn-outline-primary">編輯</a>
                        <a asp-action="Delete" asp-route-meetingId="@meeting.MeetingId" class="btn btn-sm btn-outline-danger">刪除</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
